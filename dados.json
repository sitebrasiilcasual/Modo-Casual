const GITHUB_TOKEN = "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"
const REPO = "sitebrasilcasual/modo-casual"
const FILE_PATH = "dados.json"
const BRANCH = "main"

async function salvarDados() {

  const dados = {

    tituloSite: document.getElementById("tituloSite").value,
    dataEvento: document.getElementById("dataEvento").value,
    horaEvento: document.getElementById("horaEvento").value,

    textoSobre: document.getElementById("textoSobre").value,
    textoChamada: document.getElementById("textoChamada").value,

    vagasTotal: Number(document.getElementById("vagasTotal").value),
    vagasPreenchidas: Number(document.getElementById("vagasPreenchidas").value),

    times: [
      {
        nome: document.getElementById("timeNome").value,
        logo: document.getElementById("timeLogo").value,
        capitao: document.getElementById("timeCapitao").value,
        integrante1: document.getElementById("timeInt1").value,
        integrante2: document.getElementById("timeInt2").value,
        integrante3: document.getElementById("timeInt3").value,
        integrante4: document.getElementById("timeInt4").value
      }
    ],

    patrocinadores: [
      {
        nome: document.getElementById("patNome").value,
        logo: document.getElementById("patLogo").value,
        link: document.getElementById("patLink").value
      }
    ]

  }

  const url = `https://api.github.com/repos/${REPO}/contents/${FILE_PATH}`

  const getFile = await fetch(url)
  const fileData = await getFile.json()

  const sha = fileData.sha

  const conteudo = btoa(
    unescape(
      encodeURIComponent(JSON.stringify(dados, null, 2))
    )
  )

  const resposta = await fetch(url, {
    method: "PUT",
    headers: {
      "Authorization": `Bearer ${GITHUB_TOKEN}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      message: "Atualizando dados do site",
      content: conteudo,
      sha: sha,
      branch: BRANCH
    })
  })

  const resultado = await resposta.json()

  if (resultado.commit) {
    alert("Dados salvos no GitHub ✅")
  } else {
    alert("Erro ao salvar ❌")
    console.log(resultado)
  }

      }
